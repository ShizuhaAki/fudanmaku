(define-pattern BoWaP-burst (start-angle)
  (parallel i 0 -> 4
    (bullet
      #:position (list 0 0)       
      #:direction (+ start-angle (* i 72.0))
      #:speed 5)))

(define-pattern BoWaP ()
  (let ((angleT   (random-float 0 360)))                     ; 发射帧计数
    (sequential tick 0 -> 9999
      (BoWaP-burst angleT)
      (set! angleT
            (+ angleT
               (* 12 (sind tick) (cosd tick)))))))

(define-pattern top ()
  (BoWaP))
